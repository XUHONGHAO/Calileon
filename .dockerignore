# keep (sub)sub directories at the end to exclude from explicit included
# e.g. ./packages/excalidraw/{dist,node_modules}
**/build
**/dist
**/node_modules

# Never send deployment secrets, local credentials, or backups into any build
# context. Keep the checked-in examples explicitly available below.
**/.env
**/.env.*
**/*backup*
**/backups
**/keys
**/*.key
**/*.pem
!deploy/ai-proxy/.env.example
