{$APP_ORIGIN} {
  encode zstd gzip

  @room path /socket.io/* /vault/capabilities /vault/rooms /vault/control-plane/* /healthz /readyz
  reverse_proxy @room room:8080
  reverse_proxy app:8080

  header {
    -Server
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    X-Frame-Options "SAMEORIGIN"
    # `connect-src` has to stay open to `https:`: the App talks to user-configured
    # BYOK AI providers straight from the browser, so the set of origins is not
    # knowable at deploy time. A host-source (`https://host`) does NOT authorise
    # WebSockets on the same host, hence the explicit `wss:` for Supabase Realtime;
    # `'self'` already covers the room server's `wss://` on this origin.
    Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; frame-src 'self' https:; worker-src 'self' blob:; connect-src 'self' https: wss:"
  }

  log {
    output discard
  }
}

# Supabase API origin. P7 decision (§2.6): a separate HTTPS origin served by this
# same Caddy, because only one process can bind 443 and the official Supabase
# distribution ships a self-signed certificate on its gateway.
#
# Only the API surfaces the App actually uses are exposed. The gateway root
# (`/`, which serves Studio) is deliberately NOT proxied, so the admin UI is
# never publicly reachable. To use Studio, open an SSH tunnel:
#   ssh -L 8000:127.0.0.1:8000 <host>   then browse http://127.0.0.1:8000
{$SUPABASE_PUBLIC_URL} {
  encode zstd gzip

  # Wrapped in `route` so the matcher, the proxy and the catch-all execute in
  # the written order regardless of Caddy's default directive ordering.
  route {
    @supabase_api path /auth/v1/* /rest/v1/* /storage/v1/* /functions/v1/* /realtime/v1/*
    reverse_proxy @supabase_api kong:8000
    respond 404
  }

  header {
    -Server
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
  }

  log {
    output discard
  }
}
