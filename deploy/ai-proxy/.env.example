# Build image. Keep the digest pinned; replace the registry only with an
# equivalent trusted mirror that resolves to the same digest.
AI_PROXY_NODE_IMAGE=node:20.19.4-alpine@sha256:df02558528d3d3d0d621f112e232611aecfee7cbc654f6b375765f72bb262799

# Exact browser origins, comma-separated. Wildcards and paths are rejected.
AI_PROXY_ALLOWED_ORIGINS=https://draw.example.com

# Generate a random token outside the repository. During rotation, configure
# current,previous until all browsers have moved to the current token.
AI_PROXY_CLIENT_TOKENS=replace-with-a-random-32-byte-token

AI_PROXY_CONNECT_TIMEOUT_MS=10000
AI_PROXY_REQUEST_TIMEOUT_MS=600000
AI_PROXY_IDLE_TIMEOUT_MS=120000
AI_PROXY_MAX_REQUEST_BYTES=67108864
AI_PROXY_MAX_REDIRECTS=5
AI_PROXY_SHUTDOWN_GRACE_MS=30000
AI_PROXY_LOG_TARGET_HOSTNAME=true

# Shared Docker network used by the App-facing reverse proxy and AI Proxy.
AI_PROXY_EDGE_NETWORK=excalidraw-ai-proxy-edge

# Managed AI Gateway is disabled unless explicitly enabled. Production uses
# AWS KMS and an independent Postgres schema; never commit real values here.
AI_GATEWAY_ENABLED=false
AI_GATEWAY_POSTGRES_DB=ai_gateway
AI_GATEWAY_POSTGRES_USER=ai_gateway
AI_GATEWAY_POSTGRES_PASSWORD=replace-with-a-random-database-password
AI_GATEWAY_ALLOWED_ORIGINS=https://draw.example.com,null
AI_GATEWAY_JWKS_URL=https://project.supabase.co/auth/v1/.well-known/jwks.json
AI_GATEWAY_AUTH_ISSUER=https://project.supabase.co/auth/v1
AI_GATEWAY_AUTH_AUDIENCE=authenticated
AI_GATEWAY_AUTH_ALGORITHMS=RS256,ES256
# Absolute or compose-project-relative path to a reviewed route catalog. Do
# not use routes.example.json in production; it contains placeholders.
AI_GATEWAY_CONFIG_HOST_PATH=./routes.example.json
AI_GATEWAY_KMS_PROVIDER=aws-kms
AI_GATEWAY_KMS_KEY_ID=replace-with-kms-key-arn
AI_GATEWAY_CONTENT_AUDIT_ENABLED=false
AI_GATEWAY_DEVICE_VERIFICATION_URI=https://draw.example.com/ai-device
AI_GATEWAY_METRICS_TOKEN=replace-with-a-metrics-token
AI_GATEWAY_TRUST_PROXY=true
